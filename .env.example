# ==============================================================================
# Admin Automation Agent - Environment Configuration
# ==============================================================================

# LLM Configuration (Groq with existing working model)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Email Configuration (Direct SMTP Gmail)
SMTP_EMAIL=your_coordinator_email@gmail.com
SMTP_APP_PASSWORD=your_16_char_gmail_app_password

# WhatsApp Configuration (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_WHATSAPP=whatsapp:+14155238886
TWILIO_FROM_EMAIL=

# Safety & Human-in-the-Loop Settings
# Set to True during development to prevent sending live emails/messages
DRY_RUN=True

# Authentication & Security
JWT_SECRET_KEY=admin_automation_agent_secure_jwt_secret_key_2026_change_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_DEFAULT_PASSWORD=admin123

# Data directory path (relative to backend or absolute)
DATA_DIR=../../data
CHROMADB_DIR=../../data/chroma_db

# Simulation settings (Optional: simulated date format dd-mm-yyyy e.g. 18-08-2026)
SIMULATED_TODAY=
